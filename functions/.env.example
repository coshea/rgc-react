PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=your_paypal_environment_here # SANDBOX or PRODUCTION
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
SENTRY_DSN= # optional; rgc-functions project DSN. Leave empty to keep Sentry off for local deploys
SENTRY_RELEASE= # optional; CI sets rgc-functions@<version>+<sha>
SENTRY_ENABLE_LOGS= # optional; set to false to stop sending logger output to Sentry Logs
