{
  "name": "vite-template",
  "private": true,
  "version": "10.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-full": "tsc && vite build && npm run test && npm run lint",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint -c .eslintrc.cjs ./src/**/**/*.{ts,tsx} --fix",
    "preview": "vite preview",
    "firebase": "npm run build && npm run build:functions && firebase deploy",
    "functions": "npm run build:functions && firebase deploy --only functions",
    "build:functions": "cd functions && npm run build",
    "firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "emulators:functions": "firebase emulators:start --only functions",
    "test:membership:emulator": "node scripts/test-membership-payment-emulator.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@heroui-pro/react": "^1.0.1",
    "@heroui/react": "^3.2.8",
    "@heroui/styles": "^3.2.8",
    "@number-flow/react": "^0.6.2",
    "@paypal/react-paypal-js": "^8.9.2",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-aria/visually-hidden": "^3.9.1",
    "@react-types/shared": "^3.33.1",
    "@sentry/react": "^10.78.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-query-devtools": "^5.108.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "clsx": "2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "framer-motion": "11.15.0",
    "html-to-image": "^1.11.13",
    "marked": "^18.2.1",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.1",
    "react-router-dom": "^7.18.6",
    "react-svg-pan-zoom": "^3.13.1",
    "recharts": "^3.11.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.8.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@iconify/react": "^5.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@grpc/grpc-js": "^1.14.6",
    "figlet": "^1.11.3"
  },
  "vitest": {
    "environment": "jsdom",
    "globals": true
  },
  "allowScripts": {
    "@heroui-pro/react@1.0.1": true,
    "@firebase/util": false,
    "fsevents": false,
    "protobufjs": false,
    "msw": false,
    "@zowe/secrets-for-zowe-sdk": false,
    "@sentry/cli@2.58.6": true
  }
}
