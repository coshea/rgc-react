{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint -c .eslintrc.cjs ./src/**/**/*.{ts,tsx} --fix",
    "preview": "vite preview",
    "firebase": "npm run build && npm run build:functions && firebase deploy",
    "functions": "npm run build:functions && firebase deploy --only functions",
    "build:functions": "cd functions && npm run build",
    "firestore": "firebase deploy --only firestore:rules",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "emulators:functions": "firebase emulators:start --only functions",
    "test:membership:emulator": "node scripts/test-membership-payment-emulator.mjs",
    "build-full": "npm run build && npm run test && npm run lint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@heroui-pro/react": "^1.0.0-beta.4",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@number-flow/react": "^0.6.0",
    "@paypal/react-paypal-js": "^8.9.2",
    "@react-aria/visually-hidden": "^3.8.31",
    "@react-types/shared": "^3.33.1",
    "@sentry/react": "^10.34.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-devtools": "^5.87.1",
    "@tiptap/core": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/extensions": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "clsx": "2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.10.0",
    "framer-motion": "11.15.0",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.7",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.5.0",
    "react-is": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.18.2",
    "react-svg-pan-zoom": "^3.13.1",
    "recharts": "^3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "streamdown": "^2.5.0",
    "styled-components": "^6.3.12",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "0.3.0",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@iconify/react": "^5.2.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "tar": "^7.5.21"
  },
  "vitest": {
    "environment": "jsdom",
    "globals": true
  }
